#!/bin/sh
# /usr/lib/systemd/system-shutdown/lecoo-poweroff-fix.shutdown
# Runs at late shutdown (final.target) right before the kernel enters ACPI S5.

case "$1" in
    poweroff|halt)
        # 1. Disable all ACPI and sysfs wakeup sources
        if [ -x /usr/local/bin/disable-wakeup.sh ]; then
            /usr/local/bin/disable-wakeup.sh >/dev/null 2>&1 || true
        fi

        # 2. Bring down NICs and unbind PCI drivers that assert PME#/WAKE# during S5
        for iface in /sys/class/net/*; do
            ifname=$(basename "$iface")
            [ "$ifname" != "lo" ] && ip link set "$ifname" down 2>/dev/null || true
        done

        # Unbind Realtek LAN (r8169), Realtek Wi-Fi (rtw89_8852be), USB xHCI, and Thunderbolt
        for entry in \
            "r8169:0000:0b:00.0" \
            "rtw89_8852be:0000:0c:00.0" \
            "thunderbolt:0000:70:00.5" \
            "thunderbolt:0000:70:00.6" \
            "xhci_hcd:0000:6e:00.3" \
            "xhci_hcd:0000:6e:00.4" \
            "xhci_hcd:0000:70:00.3" \
            "xhci_hcd:0000:70:00.4"
        do
            drv="${entry%%:*}"
            bdf="${entry#*:}"
            if [ -e "/sys/bus/pci/drivers/$drv/$bdf" ]; then
                echo "$bdf" > "/sys/bus/pci/drivers/$drv/unbind" 2>/dev/null || true
            fi
        done

        # 3. Mask & clear all active ACPI GPEs (gpe0A, gpe10, gpe16, gpe19, gpe1A, etc.)
        for gpe in /sys/firmware/acpi/interrupts/gpe[0-9A-Fa-f][0-9A-Fa-f]; do
            [ -f "$gpe" ] || continue
            echo disable > "$gpe" 2>/dev/null || true
            echo clear > "$gpe" 2>/dev/null || true
        done

        # 4. Set PCIEXPWAK_DIS (PEWD=1, bit 6 of PM1_EN high byte at 0x0803),
        #    clear PCIEXPWAK_STS (PEWS=1, bit 6 of PM1_STS high byte at 0x0801),
        #    and ensure FCH S5 bits from SPTS(5) (CLPS, SLPS, PWDE) are set.
        if command -v python3 >/dev/null 2>&1; then
            python3 -c '
import os, mmap
try:
    with open("/dev/port", "r+b", buffering=0) as f:
        f.seek(0x803)
        val = f.read(1)[0]
        f.seek(0x803)
        f.write(bytes([val | 0x40]))
        f.seek(0x801)
        f.write(bytes([0x40]))
except Exception:
    pass
try:
    fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
    m = mmap.mmap(fd, 0x1000, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=0xFED80000)
    m[0x288] |= 0x02                   # CLPS = 1
    m[0x2B0] = (m[0x2B0] & ~0x0C) | 0x04  # SLPS = 1
    m[0x3BB] |= 0x40                   # PWDE = 1
    m.close()
    os.close(fd)
except Exception:
    pass
' 2>/dev/null || true
        fi
        ;;
esac
exit 0
